APP_ENV=development
DATABASE_URL=sqlite:///./pingpong.db
PINGPONG_MODE=mock
PINGPONG_BASE_URL=https://sandbox-acquirer-payment.pingpongx.com
# Checkout V4 public envelope fields. Values are intentionally blank.
PINGPONG_ACC_ID=
PINGPONG_CLIENT_ID=
PINGPONG_SALT=
PINGPONG_SIGN_TYPE=SHA256
PINGPONG_APP_ID=
PINGPONG_APP_SECRET=
PINGPONG_API_TOKEN=
PINGPONG_WEBHOOK_SECRET=local-demo-secret
# Sandbox requires real, publicly reachable HTTPS URLs; replace these placeholders.
PINGPONG_NOTIFY_URL=https://example.invalid/api/webhooks/pingpong/checkout
PINGPONG_PAY_RESULT_URL=https://example.invalid/payment/result
PINGPONG_PAY_CANCEL_URL=https://example.invalid/payment/cancel
PINGPONG_TRADE_COUNTRY=
PINGPONG_SHOPPER_IP=
PINGPONG_PAYMENT_METHOD_TYPE=scheme
PINGPONG_ORDER_TERMINAL=01
MOCK_PAYMENT_STATUS=PENDING
RECONCILE_AFTER_SECONDS=3600
DEMO_AUTH_TOKENS=dev-token:developer,finance-token:finance,approver-token:approver,admin-token:admin,fde-token:fde

# Optional VCC natural-language parser. Keep disabled for deterministic tests.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_ROUTER_MODEL=deepseek-chat
LLM_ROUTER_MAX_TOKENS=512
LLM_ROUTER_TIMEOUT_SECONDS=10
